    "doctype": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "<[!][Dd][Oo][Cc][Tt][Yy][Pp][Ee]"
          },
          {
            "type": "PATTERN",
            "value": "[^>]*"
          },
          {
            "type": "STRING",
            "value": ">"
          }
        ]
      }
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<!--"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
